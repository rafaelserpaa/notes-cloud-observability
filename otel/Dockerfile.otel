# Copie para a raiz do repositório da aplicação (aula-06-cloud-cyber-app) antes do build.
# O app.py NÃO muda: o opentelemetry-instrument liga Flask, psycopg2 e requests por fora.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
      opentelemetry-distro opentelemetry-exporter-otlp \
 && opentelemetry-bootstrap -a install
COPY app.py .
COPY templates/ templates/
RUN useradd --system --uid 10001 --no-create-home app
USER 10001
EXPOSE 8080
CMD ["opentelemetry-instrument", "python", "app.py"]
