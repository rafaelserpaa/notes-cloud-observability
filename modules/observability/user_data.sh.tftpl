#!/bin/bash
# Bootstrap da EC2 de observabilidade (Fase 1 e 2 do passo a passo).
# Roda uma única vez no primeiro boot; log em /var/log/obs-bootstrap.log.
set -euo pipefail
exec > >(tee /var/log/obs-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user

docker network create obs-net || true

# Lê um secret do Secrets Manager com retry (a role pode demorar a propagar).
read_secret() {
  local value=""
  for i in $(seq 1 30); do
    value=$(aws secretsmanager get-secret-value --region ${region} \
      --secret-id "$1" --query SecretString --output text) && break
    sleep 10
  done
  printf '%s' "$value"
}

# --- Alertmanager ---
mkdir -p /opt/obs
%{ if discord_secret_arn != "" ~}
# Webhook do Discord: a URL vem do Secrets Manager e fica num arquivo só legível
# pelo usuário do container (nobody, 65534); não aparece no alertmanager.yml.
DISCORD_URL=$(read_secret "${discord_secret_arn}")
[ -n "$DISCORD_URL" ] || { echo "nao consegui ler o webhook do Discord"; exit 1; }
printf '%s' "$DISCORD_URL" > /opt/obs/discord_webhook_url
unset DISCORD_URL
chown 65534:65534 /opt/obs/discord_webhook_url
chmod 400 /opt/obs/discord_webhook_url

cat > /opt/obs/alertmanager.yml <<'EOF'
route:
  receiver: discord
  group_by: [alertname]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 30m
receivers:
  - name: discord
    discord_configs:
      - webhook_url_file: /etc/alertmanager/discord_webhook_url
        send_resolved: true
EOF
DISCORD_MOUNT="-v /opt/obs/discord_webhook_url:/etc/alertmanager/discord_webhook_url:ro"
%{ else ~}
# Sem webhook configurado: o alerta só aparece na interface do Alertmanager.
cat > /opt/obs/alertmanager.yml <<'EOF'
route:
  receiver: lab-default
  group_by: [alertname]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 30m
receivers:
  - name: lab-default
EOF
DISCORD_MOUNT=""
%{ endif ~}
chmod 644 /opt/obs/alertmanager.yml

# shellcheck disable=SC2086 # DISCORD_MOUNT vazio ou "-v origem:destino:ro"
docker run -d --name alertmanager --network obs-net --restart unless-stopped \
  -p 127.0.0.1:9093:9093 \
  -v /opt/obs/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro \
  $DISCORD_MOUNT \
  ${alertmanager_image}

# --- Senha do Grafana: vem do Secrets Manager, nunca do user_data ---
GFPASS=$(read_secret "${secret_arn}")
[ -n "$GFPASS" ] || { echo "nao consegui ler a senha do Grafana"; exit 1; }

# --- Data source do Alertmanager provisionado no Grafana ---
# handleGrafanaManagedAlerts = "Receive Grafana Alerts": as regras criadas no Grafana
# são entregues a este Alertmanager (que por sua vez notifica o Discord).
# O arquivo é montado ao lado dos data sources padrão do otel-lgtm, sem substituí-los.
cat > /opt/obs/grafana-alertmanager-datasource.yaml <<'EOF'
apiVersion: 1
datasources:
  - name: Alertmanager
    uid: alertmanager
    type: alertmanager
    access: proxy
    url: http://alertmanager:9093
    editable: false
    jsonData:
      implementation: prometheus
      handleGrafanaManagedAlerts: true
EOF
chmod 644 /opt/obs/grafana-alertmanager-datasource.yaml

# --- otel-lgtm: Grafana (3000) e OTLP HTTP (4318). A 4317 nao e publicada. ---
docker run -d --name lgtm --network obs-net --restart unless-stopped \
  -p 3000:3000 -p 4318:4318 \
  -e GF_SECURITY_ADMIN_PASSWORD="$GFPASS" \
  -e GF_USERS_ALLOW_SIGN_UP=false \
  -e GF_AUTH_ANONYMOUS_ENABLED=false \
  -e GF_SERVER_ROOT_URL=https://${grafana_fqdn} \
  -v /opt/obs/grafana-alertmanager-datasource.yaml:/otel-lgtm/grafana/conf/provisioning/datasources/alertmanager.yaml:ro \
  ${lgtm_image}

# --- Grafana envia os alertas só para o Alertmanager externo ---
# Equivale a Alerting > Settings > "External". Não existe arquivo de provisionamento
# para isso, então vai pela API assim que o Grafana responder.
for i in $(seq 1 60); do
  curl -fsS http://localhost:3000/api/health >/dev/null 2>&1 && break
  sleep 5
done
curl -fsS -u "admin:$GFPASS" -X POST http://localhost:3000/api/v1/ngalert/admin_config \
  -H 'Content-Type: application/json' \
  -d '{"alertmanagersChoice":"external"}' \
  || echo "AVISO: nao consegui ajustar alertmanagersChoice (faca em Alerting > Settings)"
unset GFPASS
